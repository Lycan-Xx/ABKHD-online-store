---
/**
 * Showroom Hero (SPEC §6.1) — static port of the mockup `Hero.tsx`.
 * Entrances are pure CSS (`hero-zoom` / fade-up utilities) so no island
 * is hydrated for the hero. The search form is a real GET form that
 * lands on `/shop?q=…` (Phase 3 wires the query into the shop page).
 */
import heroBg from '../../assets/hero-bg.jpg';
import Icon from './Icon.astro';

interface Props {
  word?: string;
  eyebrow?: string;
  subtitle?: string;
}

const {
  word = 'Shop',
  eyebrow = 'Premium Tech. Smarter Prices.',
  subtitle = 'A curated showroom of devices designed for calm, modern living.',
} = Astro.props;
---

<section class="relative mx-auto mt-20 max-w-[1240px] overflow-hidden rounded-[28px] px-3 sm:mt-24 sm:px-4">
  <div class="relative h-[52vh] min-h-[420px] overflow-hidden rounded-[24px] sm:rounded-[28px] md:h-[58vh] md:min-h-[460px]">
    <img
      src={heroBg}
      alt=""
      width={1920}
      height={1024}
      class="animate-hero-zoom absolute inset-0 h-full w-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-background/40 via-background/10 to-background/80"></div>

    <!-- Giant editorial word -->
    <h1
      class="animate-hero-word absolute inset-x-0 top-[18%] text-center font-extrabold leading-none tracking-[-0.06em] text-background mix-blend-overlay"
      style="font-size: clamp(3.75rem, 18vw, 16rem);"
    >
      {word}
    </h1>

    <!-- Bottom search panel -->
    <div
      class="animate-hero-panel absolute inset-x-3 bottom-3 flex flex-col gap-4 rounded-2xl bg-background/85 p-4 backdrop-blur sm:inset-x-6 sm:bottom-6 sm:p-5 md:inset-x-8 md:bottom-8 md:flex-row md:items-center md:justify-between md:p-6"
    >
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">— ABKHD 2026</p>
        <h2 class="mt-1 text-xl font-semibold tracking-tight sm:text-2xl md:text-[28px]">
          {eyebrow}
        </h2>
        <p class="mt-1 max-w-md text-xs text-muted-foreground sm:text-sm">{subtitle}</p>
      </div>
      <form
        method="get"
        action="/shop"
        class="flex w-full items-center gap-2 rounded-full border border-border bg-background px-2 py-1.5 md:w-auto"
      >
        <Icon name="search" class="ml-2 h-4 w-4 text-muted-foreground" />
        <input
          type="search"
          name="q"
          placeholder="Search devices"
          aria-label="Search products"
          class="w-full bg-transparent px-1 py-1.5 text-sm outline-none md:w-64"
        />
        <button
          type="submit"
          class="inline-flex items-center gap-1.5 rounded-full bg-foreground px-4 py-2 text-sm font-medium text-background transition hover:opacity-90"
        >
          Search <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </button>
      </form>
    </div>
  </div>
</section>
