---
// Footer — mockup Footer.tsx pattern with ABKHD content (SPEC §5.4).
const year = new Date().getFullYear();
const whatsappNumber = import.meta.env.VITE_WHATSAPP_NUMBER || '2348085657927';
---

<footer class="mx-auto mt-16 max-w-[1240px] px-3 pb-10 sm:px-4">
  <div class="grid grid-cols-2 gap-8 border-t border-border pt-10 md:grid-cols-[1fr_auto_auto_auto]">
    <div>
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="grid h-6 w-6 place-items-center rounded-full bg-foreground text-[10px] font-bold text-background">A</span>
        <span>ABKHD</span>
      </a>
      <p class="mt-3 max-w-xs text-sm text-muted-foreground">
        Premium tech at smarter prices. Every device tested &amp; certified. Jimeta, Yola — Nigeria.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold">About</p>
      <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
        <li><a href="/about" class="hover:text-foreground">Blog</a></li>
        <li><a href="/about" class="hover:text-foreground">Meet the Team</a></li>
        <li><a href="/contact" class="hover:text-foreground">Contact Us</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold">Support</p>
      <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
        <li><a href="/contact" class="hover:text-foreground">Contact Us</a></li>
        <li><a href="/about#shipping" class="hover:text-foreground">Shipping</a></li>
        <li><a href="/about#returns" class="hover:text-foreground">Returns</a></li>
        <li><a href="/contact" class="hover:text-foreground">FAQ</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold">Social</p>
      <div class="mt-3 flex gap-2">
        <a
          href={`https://wa.me/${whatsappNumber}`}
          target="_blank"
          rel="noopener noreferrer"
          class="grid h-8 w-8 place-items-center rounded-full bg-foreground text-background transition hover:opacity-80"
          aria-label="WhatsApp"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
            <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"></path>
          </svg>
        </a>
        <a
          href="https://www.facebook.com/share/1NSyGvuCYP/"
          target="_blank"
          rel="noopener noreferrer"
          class="grid h-8 w-8 place-items-center rounded-full bg-foreground text-background transition hover:opacity-80"
          aria-label="Facebook"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
            <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="mt-8 flex flex-wrap items-center justify-between gap-3 text-xs text-muted-foreground">
    <p>&copy; {year} ABKHD. All rights reserved.</p>
    <div class="flex gap-4">
      <a href="#" class="hover:text-foreground">Terms of Service</a>
      <a href="#" class="hover:text-foreground">Privacy Policy</a>
    </div>
  </div>
</footer>
