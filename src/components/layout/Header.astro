---
// Floating glass pill navbar — mockup Navbar.tsx pattern (SPEC §5.2).
// Scroll behavior: vanilla script swaps glass/h-14/max-w-960 ↔ glass-strong/h-12/max-w-820
// at window.scrollY > 24 (exact mockup values).
import Icon from '../showroom/Icon.astro';
import CartDrawer from '../cart/CartDrawer.astro';
import MobileNav from '../showroom/MobileNav';
import SearchOverlay from '../showroom/SearchOverlay';

const currentPath = Astro.url.pathname;

const links = [
  { to: '/', label: 'Home' },
  { to: '/shop', label: 'Shop' },
  { to: '/about', label: 'About' },
  { to: '/contact', label: 'Contact' },
];

const isActive = (to: string) =>
  to === '/' ? currentPath === '/' : currentPath.startsWith(to);
---

<div class="fixed inset-x-0 top-0 z-50 flex justify-center px-3 pt-3 sm:px-4 sm:pt-4">
  <nav
    id="site-nav"
    aria-label="Main navigation"
    class="glass nav-shape flex h-14 w-full max-w-[960px] items-center gap-8 border border-border/60 px-5 shadow-[0_8px_30px_rgb(0_0_0/0.04)] transition-all duration-500 ease-out sm:px-7"
  >
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight" aria-label="ABKHD home">
      <span class="grid h-6 w-6 place-items-center rounded-full bg-foreground text-[10px] font-bold text-background">A</span>
      <span class="text-[15px]">ABKHD</span>
    </a>

    <div class="hidden flex-1 items-center justify-center gap-7 md:flex">
      {links.map((l) => (
        <a
          href={l.to}
          class={`text-sm transition-colors ${
            isActive(l.to)
              ? 'font-semibold text-foreground'
              : 'text-muted-foreground hover:text-foreground'
          }`}
        >
          {l.label}
        </a>
      ))}
    </div>

    <div class="ml-auto flex items-center gap-1.5">
      <!-- Search — opens the live SearchOverlay island (SPEC §6.6) -->
      <button
        id="nav-search-btn"
        class="hidden h-8 w-8 place-items-center rounded-full text-muted-foreground transition hover:bg-muted hover:text-foreground sm:grid"
        aria-label="Search"
      >
        <Icon name="search" class="h-4 w-4" />
      </button>
      <button
        id="cart-toggle"
        class="relative grid h-8 w-8 place-items-center rounded-full text-muted-foreground transition hover:bg-muted hover:text-foreground"
        aria-label="Open cart"
      >
        <Icon name="shopping-bag" class="h-4 w-4" />
        <span
          id="cart-count"
          class="absolute right-1 top-1 hidden h-4 min-w-4 place-items-center rounded-full bg-foreground px-1 text-[10px] font-semibold leading-none text-background"
        >
          0
        </span>
      </button>
      <button
        id="mobile-menu-btn"
        class="grid h-8 w-8 place-items-center rounded-full text-foreground transition hover:bg-muted md:hidden"
        aria-label="Menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="h-4 w-4" />
      </button>
    </div>
  </nav>
</div>

<!-- Mobile navigation island (framer-motion drawer) -->
<MobileNav client:load />

<!-- Live search overlay island (SPEC §6.6) -->
<SearchOverlay client:idle />

<!-- Cart drawer (restyle-only, logic frozen) -->
<CartDrawer />

<script is:inline>
  // Navbar shrink on scroll — exact mockup behavior (threshold 24px)
  (function () {
    var nav = document.getElementById('site-nav');
    if (!nav) return;

    function onScroll() {
      var s = window.scrollY > 24;
      nav.classList.toggle('glass-strong', s);
      nav.classList.toggle('h-12', s);
      nav.classList.toggle('px-4', s);
      nav.classList.toggle('sm:px-5', s);
      nav.classList.toggle('max-w-[820px]', s);
      nav.classList.toggle('glass', !s);
      nav.classList.toggle('h-14', !s);
      nav.classList.toggle('px-5', !s);
      nav.classList.toggle('sm:px-7', !s);
      nav.classList.toggle('max-w-[960px]', !s);
    }

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();

  // Mobile menu button → MobileNav island (toggles the drawer)
  (function () {
    var btn = document.getElementById('mobile-menu-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      window.dispatchEvent(new CustomEvent('abkhd:mobile-nav'));
    });
  })();

  // Search button → SearchOverlay island
  (function () {
    var searchBtn = document.getElementById('nav-search-btn');
    if (!searchBtn) return;
    searchBtn.addEventListener('click', function () {
      window.dispatchEvent(new CustomEvent('abkhd:search'));
    });
  })();

  // Cart button → CartDrawer
  (function () {
    var cartToggle = document.getElementById('cart-toggle');
    if (!cartToggle) return;
    cartToggle.addEventListener('click', function () {
      window.dispatchEvent(new CustomEvent('open-cart'));
    });
  })();
</script>

<script>
  // Live cart count badge (nanostores — same wiring as before the redesign)
  import { $cartItems, getCartCount, openCart } from '../../stores/cart';
  import { createInitializer } from '../../lib/init';

  createInitializer(() => {
    function updateCartBadge() {
      const el = document.getElementById('cart-count');
      if (el) {
        const count = getCartCount();
        el.textContent = count.toString();
        el.classList.toggle('hidden', count === 0);
        el.classList.toggle('grid', count > 0);
      }
    }
    updateCartBadge();
    const unsubCart = $cartItems.subscribe(() => updateCartBadge());

    window.addEventListener('open-cart', () => openCart());

    return () => {
      unsubCart();
    };
  });
</script>
