---
// CartDrawer.astro — cart drawer using nanostores (SPEC §5.5: restyle ONLY).
// IDs, store wiring, renderCart() logic and event contract are frozen —
// other scripts (product pages, checkout) depend on them.
import Icon from '../showroom/Icon.astro';
---

<!-- Overlay -->
<div
  id="cart-overlay"
  class="fixed inset-0 z-50 bg-foreground/20 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 pointer-events-none"
  aria-hidden="true"
></div>

<!-- Cart Drawer — floating right sheet -->
<div
  id="cart-drawer"
  class="fixed inset-y-3 right-3 z-50 flex w-[calc(100%-1.5rem)] max-w-md translate-x-[calc(100%+2rem)] flex-col rounded-3xl border border-border/70 bg-background shadow-[0_30px_80px_-30px_rgb(0_0_0/0.25)] transition-transform duration-500 [transition-timing-function:cubic-bezier(0.22,1,0.36,1)]"
  role="dialog"
  aria-label="Shopping Cart"
  aria-modal="true"
>
  <!-- Header -->
  <div class="flex items-center justify-between px-5 pb-3 pt-4">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">— Your Cart</p>
    <button
      id="cart-close"
      class="grid h-9 w-9 place-items-center rounded-full text-muted-foreground transition hover:bg-muted hover:text-foreground"
      aria-label="Close cart"
    >
      <Icon name="x" class="h-4 w-4" />
    </button>
  </div>

  <!-- Cart Items -->
  <div id="cart-items-container" class="flex-1 overflow-y-auto px-5 py-2">
    <div id="cart-empty" class="py-8 text-center">
      <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-muted text-muted-foreground">
        <Icon name="shopping-bag" class="h-6 w-6" strokeWidth={1.5} />
      </div>
      <p class="mt-4 text-sm font-medium">Your cart is empty</p>
      <a
        href="/shop"
        class="mt-5 inline-flex items-center justify-center rounded-full border border-border bg-background px-5 py-2.5 text-sm font-medium transition hover:bg-muted"
      >
        Browse the showroom
      </a>
    </div>
    <div id="cart-items-list" class="space-y-3 hidden"></div>
  </div>

  <!-- Footer -->
  <div id="cart-footer" class="space-y-4 border-t border-border/70 p-5 hidden">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Total</span>
      <span class="font-semibold"><span id="cart-total">₦0</span></span>
    </div>
    <a
      href="/checkout"
      id="cart-checkout"
      class="flex w-full items-center justify-center rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition hover:opacity-90"
    >
      Checkout
    </a>
  </div>
</div>

<script>
  import { $cartItems, $isCartOpen, getCartItemsArray, getCartSubtotal, removeFromCart, closeCart, openCart } from '../../stores/cart';
  import { createInitializer } from '../../lib/init';

  // lucide trash-2 (inlined — frontmatter values are not visible to client scripts)
  const TRASH_SVG =
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>';

  function formatPrice(price: number): string {
    return '₦' + price.toLocaleString();
  }

  createInitializer(() => {
    function renderCart() {
      const items = getCartItemsArray();
      const emptyEl = document.getElementById('cart-empty');
      const listEl = document.getElementById('cart-items-list');
      const footerEl = document.getElementById('cart-footer');
      const totalEl = document.getElementById('cart-total');

      if (!emptyEl || !listEl || !footerEl || !totalEl) return;

      if (items.length === 0) {
        emptyEl.classList.remove('hidden');
        listEl.classList.add('hidden');
        footerEl.classList.add('hidden');
        return;
      }

      emptyEl.classList.add('hidden');
      listEl.classList.remove('hidden');
      footerEl.classList.remove('hidden');

      totalEl.textContent = formatPrice(getCartSubtotal());

      listEl.innerHTML = items.map(item => `
        <div class="flex items-center space-x-4 rounded-2xl border border-border/70 p-4" data-cart-id="${item.cartId}">
          <img src="${item.image}" alt="${item.name}" class="h-16 w-16 rounded-xl object-cover" crossorigin="anonymous" />
          <div class="min-w-0 flex-1">
            <h3 class="truncate text-sm font-medium">${item.name}</h3>
            <div class="mt-1 space-y-0.5 text-xs text-muted-foreground">
              ${item.size ? `<p>Size: ${item.size}</p>` : ''}
              ${item.color ? `<p>Color: ${item.color}</p>` : ''}
              <p>${formatPrice(item.price)} × ${item.quantity}</p>
            </div>
          </div>
          <button class="cart-remove-item grid h-9 w-9 shrink-0 place-items-center rounded-full text-muted-foreground transition hover:bg-muted hover:text-foreground" data-cart-id="${item.cartId}" aria-label="Remove item">
            ${TRASH_SVG}
          </button>
        </div>
      `).join('');

      listEl.querySelectorAll('.cart-remove-item').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const cartId = (e.currentTarget as HTMLElement).dataset.cartId;
          if (cartId) removeFromCart(cartId);
        });
      });
    }

    function openDrawer() {
      const drawer = document.getElementById('cart-drawer');
      const overlay = document.getElementById('cart-overlay');
      if (drawer && overlay) {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        drawer.classList.remove('translate-x-[calc(100%+2rem)]');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeDrawer() {
      const drawer = document.getElementById('cart-drawer');
      const overlay = document.getElementById('cart-overlay');
      if (drawer && overlay) {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        drawer.classList.add('translate-x-[calc(100%+2rem)]');
        document.body.style.overflow = '';
      }
    }

    // Subscribe to store changes
    const unsubItems = $cartItems.subscribe(() => renderCart());
    const unsubOpen = $isCartOpen.subscribe((isOpen) => {
      if (isOpen) {
        renderCart();
        openDrawer();
      } else {
        closeDrawer();
      }
    });

    // Close button & overlay
    const cartCloseBtn = document.getElementById('cart-close');
    const cartOverlay = document.getElementById('cart-overlay');

    const handleClose = () => closeCart();

    cartCloseBtn?.addEventListener('click', handleClose);
    cartOverlay?.addEventListener('click', handleClose);

    // Initial render
    renderCart();

    return () => {
      unsubItems();
      unsubOpen();
      cartCloseBtn?.removeEventListener('click', handleClose);
      cartOverlay?.removeEventListener('click', handleClose);
    };
  });
</script>
