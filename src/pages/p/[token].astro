---
export const prerender = false;

import PromoLayout from '../../layouts/PromoLayout.astro';
import { PromoExperience } from '../../components/promo/PromoExperience';
import { eventPhase } from '../../lib/promo';
import { getEventByToken, loadPublicItems } from '../../lib/promo-server';

const { token } = Astro.params;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

let event = null;
let backendFailed = false;
try {
  event = await getEventByToken(token);
} catch (error) {
  // A failing backend is not "page not found": say so (and log why) instead
  // of showing a 404 that hides the real problem.
  console.error('Promo lookup failed:', error);
  backendFailed = true;
}

// Unknown or malformed token: indistinguishable from any other missing page.
if (!backendFailed && !event) return Astro.rewrite('/404');

const phase = event ? eventPhase(event) : 'ended';
let items: Awaited<ReturnType<typeof loadPublicItems>> = [];
if (event && phase === 'live') {
  try {
    items = await loadPublicItems(event);
  } catch (error) {
    console.error('Promo items load failed:', error);
    backendFailed = true;
  }
}
if (backendFailed) Astro.response.status = 503;
---

<PromoLayout title={`${event?.title ?? 'Promo'} | ABKHD`}>
  {
    backendFailed || !event ? (
      <section class="flex min-h-[60vh] flex-col items-center justify-center text-center">
        <h1 class="text-2xl font-semibold tracking-tight">We could not load this offer</h1>
        <p class="mt-3 max-w-md text-sm text-muted-foreground">
          Something went wrong on our side. Please try again in a moment.
        </p>
        <a
          href={Astro.url.pathname}
          class="mt-8 inline-flex items-center justify-center rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition hover:opacity-90"
        >
          Try again
        </a>
      </section>
    ) : phase === 'live' ? (
      <PromoExperience
        client:load
        token={token as string}
        title={event.title}
        endsAt={event.endsAt ?? null}
        initialItems={items}
      />
    ) : (
      <section class="flex min-h-[60vh] flex-col items-center justify-center text-center">
        <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">
          {phase === 'upcoming' ? 'Coming soon' : 'Event ended'}
        </p>
        <h1 class="mt-4 text-3xl font-semibold tracking-tight">{event.title}</h1>
        <p class="mt-3 max-w-md text-sm text-muted-foreground">
          {phase === 'upcoming'
            ? 'This offer has not started yet. Scan the code again when the event opens.'
            : 'This offer has ended. Thank you for stopping by.'}
        </p>
        <a
          href="/"
          class="mt-8 inline-flex items-center justify-center rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition hover:opacity-90"
        >
          Visit the store
        </a>
      </section>
    )
  }
</PromoLayout>
