---
export const prerender = false;

import PromoLayout from '../../../layouts/PromoLayout.astro';
import { CheckoutReceipt } from '../../../components/receipt/CheckoutReceipt';
import { isPromoRef } from '../../../lib/promo';
import { getEventByToken, verifyAndFinalize } from '../../../lib/promo-server';
import { mapOrderToReceipt } from '../../../lib/receiptUtils';

const { token } = Astro.params;
const reference = Astro.url.searchParams.get('reference') || '';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

// A buyer who has just paid must never land on a 404 because of a backend
// hiccup: only a genuinely unknown token/reference is "not found".
let event = null;
let lookupFailed = false;
try {
  event = await getEventByToken(token);
} catch (error) {
  console.error('Promo thanks lookup failed:', error);
  lookupFailed = true;
}
if (!isPromoRef(reference) || (!lookupFailed && !event)) return Astro.rewrite('/404');

let result: Awaited<ReturnType<typeof verifyAndFinalize>> = { state: 'unknown' };
try {
  result = await verifyAndFinalize(reference, Astro.url.hostname);
} catch (error) {
  console.error('Promo thanks verify failed:', error);
}

const order = result.order;
const receipt =
  result.state === 'paid' && order
    ? mapOrderToReceipt(order as any, [], { paymentStatus: 'Confirmed', badgeStatus: 'PAID' })
    : null;
---

<PromoLayout title="Your order | ABKHD">
  {
    receipt ? (
      <section class="mx-auto max-w-3xl">
        <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">Payment confirmed</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight">It's yours.</h1>
        <p class="mt-2 text-sm text-muted-foreground">
          Keep this receipt. We will contact you to arrange delivery.
        </p>
        <div class="mt-8">
          <CheckoutReceipt client:only="react" data={receipt} />
        </div>
      </section>
    ) : result.state === 'refund_due' ? (
      <section class="mx-auto flex min-h-[50vh] max-w-md flex-col items-center justify-center text-center">
        <h1 class="text-2xl font-semibold tracking-tight">Someone else got there first</h1>
        <p class="mt-3 text-sm text-muted-foreground">
          Your payment arrived just after this item was claimed. You will be refunded in full.
          Reference: <strong>{reference}</strong>
        </p>
      </section>
    ) : (
      <section class="mx-auto flex min-h-[50vh] max-w-md flex-col items-center justify-center text-center">
        <h1 class="text-2xl font-semibold tracking-tight">Awaiting confirmation</h1>
        <p class="mt-3 text-sm text-muted-foreground">
          We have not received confirmation of this payment yet. This page checks again each time you open it.
          Reference: <strong>{reference}</strong>
        </p>
        <a
          href={Astro.url.pathname + Astro.url.search}
          class="mt-6 inline-flex items-center justify-center rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition hover:opacity-90"
        >
          Check again
        </a>
      </section>
    )
  }
</PromoLayout>
