---
// Contact — mockup split layout (SPEC §7.7): statement left, card form right
// with `field-input` underline fields. The form submission handler below is
// preserved verbatim from the previous page (same ids, same simulated
// transport), only its success state now renders the mockup "Sent — Thank
// you." panel instead of an alert().
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const whatsappNumber = import.meta.env.VITE_WHATSAPP_NUMBER || '2348085657927';
---

<Layout
  title="Contact Us - ABKHD Store"
  description="Get in touch with the ABKHD team — questions about a product, an order, or anything else."
>
  <Header slot="header" />

  <main class="mx-auto grid max-w-[1100px] gap-16 px-6 pt-40 pb-24 md:grid-cols-2">
    <!-- Left: statement + contact rows -->
    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">— Contact</p>
      <h1 class="mt-4 text-balance text-5xl font-semibold leading-[1.05] tracking-tight md:text-6xl">
        Say hello.
      </h1>
      <p class="mt-6 max-w-md text-base leading-relaxed text-muted-foreground">
        Questions about a product, an order, or the brand? Drop a line — we read every message.
      </p>

      <div class="mt-10 space-y-4 text-sm text-muted-foreground">
        <a
          href={`https://wa.me/${whatsappNumber}`}
          class="group flex items-center gap-3 transition-colors hover:text-foreground"
        >
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent transition-colors group-hover:bg-foreground group-hover:text-background">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"></path>
            </svg>
          </span>
          <span class="text-foreground">+234 808 565 7927</span>
          <span class="text-muted-foreground">· fastest, replies in minutes</span>
        </a>

        <a
          href="mailto:abkhdtechgadgets@gmail.com"
          class="group flex items-center gap-3 transition-colors hover:text-foreground"
        >
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent transition-colors group-hover:bg-foreground group-hover:text-background">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <span class="text-foreground">abkhdtechgadgets@gmail.com</span>
        </a>

        <p class="flex items-center gap-3">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <span>We typically respond within 2 hours during business hours</span>
        </p>
      </div>
    </div>

    <!-- Right: form card -->
    <form
      id="contact-form-element"
      class="space-y-5 rounded-3xl border border-border bg-card p-6 md:p-8"
    >
      <div id="contact-success" class="hidden grid h-full place-items-center text-center">
        <div>
          <p class="text-sm uppercase tracking-[0.2em] text-muted-foreground">Sent</p>
          <h3 class="mt-2 text-2xl font-semibold tracking-tight">Thank you.</h3>
          <p class="mt-2 text-sm text-muted-foreground">We'll be in touch shortly.</p>
        </div>
      </div>

      <div id="contact-fields" class="space-y-5">
        <label class="block">
          <span class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Name</span>
          <div class="mt-1">
            <input required type="text" id="name" name="name" class="field-input" placeholder="Your name" />
          </div>
        </label>

        <label class="block">
          <span class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Email</span>
          <div class="mt-1">
            <input required type="email" id="email" name="email" class="field-input" placeholder="your@email.com" />
          </div>
        </label>

        <label class="block">
          <span class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Subject</span>
          <div class="mt-1">
            <input required type="text" id="subject" name="subject" class="field-input" placeholder="What's this about?" />
          </div>
        </label>

        <label class="block">
          <span class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Message</span>
          <div class="mt-1">
            <textarea required id="message" name="message" rows="5" class="field-input resize-none" placeholder="Tell us more..."></textarea>
          </div>
        </label>

        <button
          type="submit"
          id="contact-submit"
          class="w-full rounded-full bg-foreground px-5 py-3 text-sm font-medium text-background transition hover:opacity-90 disabled:opacity-60"
        >
          Send message
        </button>
      </div>
    </form>
  </main>

  <Footer slot="footer" />
</Layout>

<script>
  // Contact form — submission handler preserved verbatim from the previous
  // page (same ids, same simulated transport). Only the presentation of the
  // success state changed (mockup "Sent — Thank you." panel).
  const formElement = document.getElementById('contact-form-element');

  if (formElement) {
    formElement.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = formElement.querySelector('button[type="submit"]');
      const originalText = submitBtn.innerHTML;

      // Show loading state
      submitBtn.innerHTML = `
        <span class="flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 animate-spin" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          Sending...
        </span>
      `;
      submitBtn.disabled = true;

      // Simulate form submission
      await new Promise((resolve) => setTimeout(resolve, 1000));

      // Show success message
      const fields = document.getElementById('contact-fields');
      const success = document.getElementById('contact-success');
      if (fields && success) {
        fields.classList.add('hidden');
        success.classList.remove('hidden');
      }

      // Reset form
      formElement.reset();

      // Reset button
      submitBtn.innerHTML = originalText;
      submitBtn.disabled = false;
    });
  }
</script>
