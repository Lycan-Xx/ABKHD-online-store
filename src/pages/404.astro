---
// 404 — mockup pattern (SPEC §7.10): centered micro-label, heading, pill CTA.
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout
  title="Page not found – ABKHD Store"
  description="The page you're looking for doesn't exist or may have moved."
>
  <Header slot="header" />

  <section class="flex min-h-[70vh] flex-col items-center justify-center px-4 pt-24 text-center">
    <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">— 404</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 max-w-md text-sm text-muted-foreground">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition hover:opacity-90"
    >
      Go home
    </a>
  </section>

  <Footer slot="footer" />
</Layout>
