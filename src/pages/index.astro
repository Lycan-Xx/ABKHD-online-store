---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/showroom/Hero.astro";
import CtaBanner from "../components/showroom/CtaBanner.astro";
import { FeaturedDeals } from "../components/showroom/FeaturedDeals";
import { toShowroomProduct, type ProductDoc } from "../lib/showroom";
import { listProductsCached } from "../lib/product-cache";
import { Query } from "appwrite";

// How many featured products the homepage teases (the rest live on /shop).
const TEASER_COUNT = 6;

// Featured products, newest first.
let featuredProducts: ProductDoc[] = [];
try {
  const documents = await listProductsCached(
    [
      Query.equal("featured", true),
      Query.equal("isActive", true),
      Query.equal("isArchived", false),
      Query.orderDesc("$createdAt"),
    ],
    TEASER_COUNT,
  );
  featuredProducts = documents.map((doc) => ({ ...doc, id: doc.$id }));
} catch (error) {
  console.error("Error fetching featured products:", error);
}

// The homepage is a teaser: a few featured deals, then /shop for everything else.
const teaserProducts = featuredProducts.slice(0, TEASER_COUNT).map(toShowroomProduct);
---

<Layout
  title="Featured | ABKHD Store"
  description="Hand-picked, tested tech at smarter prices. Browse this week's featured devices."
>
  <Header slot="header" />

  <Hero
    word="ABKHD"
    eyebrow="Premium Tech. Smarter Prices."
    subtitle="UK & China-sourced devices, rigorously tested and transparently disclosed, quality you can trust at prices that actually make sense."
  />

  <FeaturedDeals client:visible products={teaserProducts} />

  <CtaBanner />

  <Footer slot="footer" />
</Layout>
