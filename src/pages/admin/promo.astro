---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/showroom/Icon.astro';
---

<AdminLayout title="Promo events | ABKHD Admin">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold">Promo events</h1>
        <p class="text-muted-foreground mt-1">
          Secret, single-purchase deal pages reached only through a QR code.
        </p>
      </div>
      <button id="new-event-btn" class="btn-primary">
        <Icon name="plus" class="mr-2 h-4 w-4" strokeWidth={2} />
        New event
      </button>
    </div>

    <form id="new-event-form" class="hidden rounded-xl border bg-card p-6 space-y-4">
      <h2 class="text-lg font-semibold">Create event</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-3">
          <label for="ev-title" class="block text-sm font-medium mb-2">Title <span class="text-red-500">*</span></label>
          <input id="ev-title" required maxlength="120" class="w-full px-4 py-2.5 rounded-lg border bg-background text-sm focus:outline-none focus:ring-2 focus:ring-ring" placeholder="e.g. Launch Weekend Deals" />
        </div>
        <div>
          <label for="ev-start" class="block text-sm font-medium mb-2">Starts (optional)</label>
          <input id="ev-start" type="datetime-local" class="w-full px-4 py-2.5 rounded-lg border bg-background text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
        </div>
        <div>
          <label for="ev-end" class="block text-sm font-medium mb-2">Ends (optional)</label>
          <input id="ev-end" type="datetime-local" class="w-full px-4 py-2.5 rounded-lg border bg-background text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
        </div>
      </div>
      <p id="new-event-error" class="hidden text-sm text-red-500"></p>
      <div class="flex gap-2">
        <button type="submit" class="btn-primary">Create and generate QR</button>
        <button type="button" id="cancel-new" class="btn-secondary">Cancel</button>
      </div>
    </form>

    <div id="events-state" class="text-center py-12 text-muted-foreground">Loading events…</div>
    <div id="events-list" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
  </div>
</AdminLayout>

<script>
  import { Query } from 'appwrite';
  import { databases, APPWRITE_DB_ID, ID } from '../../lib/appwrite';
  import { PROMO_EVENTS_COLLECTION, eventPhase, generatePromoToken, type PromoEvent } from '../../lib/promo';
  import { esc, fromLocalInput } from '../../lib/promo-admin';

  function init() {
  if (!document.getElementById('events-list')) return;
  const list = document.getElementById('events-list')!;
  const state = document.getElementById('events-state')!;
  const form = document.getElementById('new-event-form') as HTMLFormElement;
  const errorEl = document.getElementById('new-event-error')!;

  document.getElementById('new-event-btn')!.addEventListener('click', () => form.classList.toggle('hidden'));
  document.getElementById('cancel-new')!.addEventListener('click', () => form.classList.add('hidden'));

  const PHASE_STYLE: Record<string, string> = {
    live: 'bg-green-500/10 text-green-600',
    upcoming: 'bg-yellow-500/10 text-yellow-600',
    ended: 'bg-muted text-muted-foreground',
  };

  function fmt(iso?: string | null) {
    return iso ? new Date(iso).toLocaleString('en-NG', { dateStyle: 'medium', timeStyle: 'short' }) : '—';
  }

  async function load() {
    try {
      const res = await databases.listDocuments(APPWRITE_DB_ID, PROMO_EVENTS_COLLECTION, [
        Query.orderDesc('$createdAt'),
        Query.limit(50),
      ]);
      const events = res.documents as unknown as PromoEvent[];
      state.classList.toggle('hidden', events.length > 0);
      state.textContent = events.length ? '' : 'No events yet. Create one to get started.';
      list.innerHTML = events
        .map((e) => {
          const phase = eventPhase(e);
          return `
            <a href="/admin/promo/${esc(e.$id)}" class="rounded-xl border bg-card p-5 transition-all hover:shadow-md block">
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-semibold">${esc(e.title)}</h3>
                <span class="px-2.5 py-1 rounded-full text-xs font-medium ${PHASE_STYLE[phase]}">${phase}</span>
              </div>
              <p class="text-xs text-muted-foreground mt-3">Starts: ${fmt(e.startsAt)}</p>
              <p class="text-xs text-muted-foreground">Ends: ${fmt(e.endsAt)}</p>
            </a>`;
        })
        .join('');
    } catch (err) {
      console.error('Failed to load promo events:', err);
      state.textContent =
        'Could not load events. Has the promo setup script been run? (yarn setup-promo)';
    }
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    errorEl.classList.add('hidden');
    const title = (document.getElementById('ev-title') as HTMLInputElement).value.trim();
    const startsAt = fromLocalInput((document.getElementById('ev-start') as HTMLInputElement).value);
    const endsAt = fromLocalInput((document.getElementById('ev-end') as HTMLInputElement).value);
    if (startsAt && endsAt && endsAt <= startsAt) {
      errorEl.textContent = 'The end must be after the start.';
      errorEl.classList.remove('hidden');
      return;
    }
    try {
      const doc = await databases.createDocument(APPWRITE_DB_ID, PROMO_EVENTS_COLLECTION, ID.unique(), {
        title,
        token: generatePromoToken(),
        startsAt,
        endsAt,
        active: true,
      });
      window.location.href = `/admin/promo/${doc.$id}`;
    } catch (err: any) {
      errorEl.textContent = 'Could not create the event: ' + (err?.message || 'unknown error');
      errorEl.classList.remove('hidden');
    }
  });

  load();
  }

  // Runs on first load and after every view-transition navigation.
  document.addEventListener('astro:page-load', init);
</script>
