---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Icon from '../../components/showroom/Icon.astro';
import { ProductStage } from '../../components/showroom/ProductStage';
import { ProductDetail } from '../../components/showroom/ProductDetail';
import { RecommendationsRail } from '../../components/showroom/RecommendationsRail';
import { toShowroomProduct } from '../../lib/showroom';
import { databases, APPWRITE_DB_ID, APPWRITE_PRODUCTS_COLLECTION_ID } from '../../lib/appwrite';
import { Query } from 'appwrite';

export const prerender = false;

// For SSR: fetch product directly instead of using getStaticPaths
const { id } = Astro.params;

let product = null;
let relatedProducts = [];

try {
  product = await databases.getDocument(APPWRITE_DB_ID, APPWRITE_PRODUCTS_COLLECTION_ID, id);

  // Get related products (same category, excluding current product)
  const relatedResponse = await databases.listDocuments(
    APPWRITE_DB_ID,
    APPWRITE_PRODUCTS_COLLECTION_ID,
    [
      Query.equal('category', product.category),
      Query.notEqual('$id', product.$id),
      Query.equal('isActive', true),
      Query.equal('isArchived', false),
      Query.limit(4)
    ]
  );
  relatedProducts = relatedResponse.documents.map(p => ({
    ...p,
    id: p.$id
  }));
} catch (error) {
  console.error('Error fetching product:', error);
  return Astro.redirect('/404');
}

const showroomProduct = toShowroomProduct(product);
const related = relatedProducts.map(toShowroomProduct);

// OG meta — preserved (SPEC §7.4)
const ogImage = product.images?.[0] || product.image;
const ogDescription = product.description || `Buy ${product.name} for ₦${product.price.toLocaleString()}`;
---

<Layout
  title={`${product.name} - ABKHD Store`}
  description={ogDescription}
  ogImage={ogImage}
  ogType="product"
>
  <Header slot="header" />

  <!-- pb-32 clears the sticky mobile action bar (mockup pattern) -->
  <main class="min-h-screen bg-background pb-32 md:pb-0">
    <section class="mx-auto max-w-[1240px] px-3 pt-28 sm:px-4 md:pt-32">
      <a
        href="/shop"
        class="inline-flex items-center gap-2 text-sm text-muted-foreground transition hover:text-foreground"
      >
        <Icon name="arrow-left" class="h-4 w-4" /> Back to Showroom
      </a>

      <div class="mt-6 grid gap-8 md:mt-10 md:grid-cols-2 md:gap-14">
        <ProductStage client:visible product={showroomProduct} />
        <ProductDetail client:load product={showroomProduct} />
      </div>
    </section>

    {related.length > 0 && (
      <RecommendationsRail
        client:visible
        products={related}
        eyebrow="You may also like"
        title="From the same room"
      />
    )}
  </main>

  <Footer slot="footer" />
</Layout>
