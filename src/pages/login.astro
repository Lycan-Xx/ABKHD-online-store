---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

// Redirect away if already authenticated
---

<Layout title="Sign In – ABKHD Store">
  <Header slot="header" />

  <div class="login-page">
    <div class="login-card">
      <!-- Logo -->
      <div class="login-logo">
        <a href="/" aria-label="Back to ABKHD Store">
          <span class="font-black text-2xl tracking-tight">ABKHD</span>
          <span class="font-light text-2xl text-muted-foreground">Store</span>
        </a>
      </div>

      <p class="login-eyebrow">— Sign in</p>
      <h1 class="login-title">Welcome back</h1>
      <p class="login-sub">Sign in to continue</p>

      <form id="login-form" class="login-form" novalidate>
        <div class="field-group">
          <label for="email" class="field-label">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="field-input"
            placeholder="you@example.com"
          />
        </div>

        <div class="field-group">
          <label for="password" class="field-label">Password</label>
          <div class="input-wrap">
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="field-input"
              placeholder="••••••••"
            />
            <button type="button" id="pw-toggle" class="pw-eye" aria-label="Toggle password visibility">
              <span id="pw-icon"></span>
            </button>
          </div>
        </div>

        <div id="error-message" class="error-box hidden">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
          <span id="error-text">Invalid email or password.</span>
        </div>

        <button type="submit" id="login-button" class="login-btn">
          <span id="btn-label">Sign in</span>
          <span id="btn-icon"></span>
        </button>
      </form>

      <div class="login-footer">
        <a href="/" class="back-link">
          Back to store
        </a>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<style>
  .login-page {
    min-height: calc(100vh - 200px);
    display: flex; align-items: center; justify-content: center;
    padding: 7rem 1rem 2rem;
  }
  .login-card {
    width: 100%; max-width: 400px;
    background: rgb(var(--card));
    border: 1px solid rgb(var(--border) / 0.7);
    border-radius: 1.5rem;
    padding: 40px 36px;
    box-shadow: 0 8px 40px -12px rgba(0, 0, 0, 0.12);
  }
  .login-logo {
    text-align: center; margin-bottom: 24px;
    text-decoration: none;
  }
  .login-logo a { text-decoration: none; }
  .login-eyebrow {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgb(var(--muted-foreground));
    text-align: center;
    margin-bottom: 6px;
  }
  .login-title {
    font-size: 1.5rem; font-weight: 600;
    letter-spacing: -0.01em; text-align: center;
    color: rgb(var(--foreground)); margin-bottom: 4px;
  }
  .login-sub {
    font-size: 13px; color: rgb(var(--muted-foreground));
    text-align: center; margin-bottom: 28px;
  }
  .login-form { display: flex; flex-direction: column; gap: 18px; }
  .field-group { display: flex; flex-direction: column; gap: 6px; }
  .field-label {
    font-size: 0.7rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.18em;
    color: rgb(var(--muted-foreground));
  }
  /* `field-input` (underline) comes from global.css — mockup contact pattern. */
  .input-wrap { position: relative; }
  .input-wrap .field-input { padding-right: 2.75rem; }
  .pw-eye {
    position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    background: none; border: none; cursor: pointer;
    color: rgb(var(--muted-foreground)); padding: 2px;
    display: flex; align-items: center; justify-content: center;
    transition: color 0.15s;
  }
  .pw-eye:hover { color: rgb(var(--foreground)); }

  .error-box {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 14px; border-radius: 0.75rem;
    background: rgb(var(--destructive) / 0.08);
    border: 1px solid rgb(var(--destructive) / 0.25);
    color: rgb(var(--destructive)); font-size: 13px;
  }
  .error-box.hidden { display: none; }

  .login-btn {
    width: 100%; padding: 12px 20px;
    border-radius: 9999px; border: none; cursor: pointer;
    background: rgb(var(--foreground)); color: rgb(var(--background));
    font-size: 14px; font-weight: 500;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: opacity 0.15s, transform 0.12s;
    margin-top: 4px;
  }
  .login-btn:hover:not(:disabled) {
    opacity: 0.9;
    transform: translateY(-1px);
  }
  .login-btn:disabled { opacity: 0.65; cursor: not-allowed; }

  .login-footer { margin-top: 24px; text-align: center; }
  .back-link {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 13px; color: rgb(var(--muted-foreground));
    text-decoration: none; transition: color 0.15s;
  }
  .back-link:hover { color: rgb(var(--foreground)); }
</style>

<script>
  import { account, teams } from '../lib/appwrite';
  import { lucideIcon } from '../lib/lucideIcons';

  // ── Initial button icons ──
  const btnIcon = document.getElementById('btn-icon');
  const pwIcon = document.getElementById('pw-icon');
  if (btnIcon) btnIcon.innerHTML = lucideIcon('arrow-right', 'w-4 h-4');
  if (pwIcon) pwIcon.innerHTML = lucideIcon('eye', 'w-4 h-4');

  // ── Redirect if already authenticated ──
  (async () => {
    try {
      const user = await account.get();
      const userTeams = await teams.list();
      const labels = (user as any).labels || [];
      const isAdmin = labels.includes('admin') ||
                      userTeams.teams.some((t: any) => t.$id === 'admin' || t.name.toLowerCase() === 'admin');
      if (isAdmin) {
        window.location.href = '/admin';
      } else {
        // Logged-in but not an admin: redirect to storefront
        window.location.href = '/';
      }
    } catch {
      // Not logged in — stay on page
    }
  })();

  // ── Password toggle ──
  const pwToggle = document.getElementById('pw-toggle');
  const pwInput  = document.getElementById('password') as HTMLInputElement;
  pwToggle?.addEventListener('click', () => {
    const isHidden = pwInput.type === 'password';
    pwInput.type = isHidden ? 'text' : 'password';
    if (pwIcon) pwIcon.innerHTML = lucideIcon(isHidden ? 'eye-off' : 'eye', 'w-4 h-4');
  });

  // ── Login form ──
  const form      = document.getElementById('login-form') as HTMLFormElement;
  const errorBox  = document.getElementById('error-message') as HTMLDivElement;
  const errorText = document.getElementById('error-text') as HTMLSpanElement;
  const loginBtn  = document.getElementById('login-button') as HTMLButtonElement;
  const btnLabel  = document.getElementById('btn-label') as HTMLSpanElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const email    = (fd.get('email') as string).trim();
    const password = fd.get('password') as string;

    // Clear previous error
    errorBox.classList.add('hidden');
    loginBtn.disabled = true;
    btnLabel.textContent = 'Signing in…';
    if (btnIcon) btnIcon.innerHTML = lucideIcon('refresh-cw', 'w-4 h-4 animate-spin');

    try {
      await account.createEmailPasswordSession(email, password);
      window.location.href = '/admin';
    } catch (err: any) {
      loginBtn.disabled = false;
      btnLabel.textContent = 'Sign in';
      if (btnIcon) btnIcon.innerHTML = lucideIcon('arrow-right', 'w-4 h-4');
      errorText.textContent = err.message || 'Login failed. Please try again.';
      errorBox.classList.remove('hidden');
    }
  });
</script>
