---
import '../styles/global.css';
import BrandIcons from '../components/layout/BrandIcons.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const { 
  title = "ABKHD | store", 
  description = "Premium tech at smarter prices",
  ogImage,
  ogType = 'website'
} = Astro.props;

const siteUrl = 'https://abkhd.pages.dev';
const siteName = 'ABKHD Store';
// Default share card: the logo on a 1200x630 canvas (public/og-image.png).
const defaultImage = `${siteUrl}/og-image.png`;
// Product pages pass their own photo; make sure whatever we got is absolute,
// because crawlers (WhatsApp, X, Facebook) will not resolve a relative path.
const absolute = (value: string) => {
  try {
    return new URL(value, siteUrl).toString();
  } catch {
    return defaultImage;
  }
};
const imageUrl = ogImage ? absolute(ogImage) : defaultImage;
const usingDefaultImage = !ogImage;
// Canonical URL without query/hash so shared and tracked links collapse to one page.
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageAlt = usingDefaultImage ? 'ABKHD logo: a circuit-board shopping bag' : title;

const organizationJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ABKHD',
  url: siteUrl,
  logo: `${siteUrl}/logo-512.png`,
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon, touch icons, manifest, theme colour -->
    <BrandIcons />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn, iMessage, Telegram...) -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {
      usingDefaultImage && (
        <>
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={organizationJsonLd} is:inline />

    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script is:inline>
      // Showroom redesign: light-only UI. One-time cleanup of the retired
      // dark-mode preference so it can never re-apply a stale theme.
      (function() {
        try {
          localStorage.removeItem('darkMode');
          document.documentElement.classList.remove('dark');
        } catch (e) { /* storage unavailable - ignore */ }
      })()
    </script>
    
    <!-- Cloudflare Insights Beacon (production only, so dev never hits the CDN) -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "8c78df7c7c0f484497ecbca7046644da1771523124516"}'
        />
      )
    }
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <slot name="header" />
      <main class="flex-1">
        <slot />
      </main>
      <slot name="footer" />
    </div>
    <script>
      // Appwrite client initialization is handled in src/lib/appwrite.ts
    </script>
  </body>
</html>